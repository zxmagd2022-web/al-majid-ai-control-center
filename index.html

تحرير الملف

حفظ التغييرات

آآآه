
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AL MAJID AI CONTROL CENTER</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f2f6f3;color:#18251e;font-family:Arial,Tahoma,sans-serif}
header{background:#10291d;color:white;padding:15px;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:10px}
.brand img{width:48px;height:48px;object-fit:contain;background:white;border-radius:8px}
.brand h2{font-size:16px;margin:0 0 5px}
.brand small{color:#b8d9c5}
button,.btn{border:0;border-radius:8px;padding:10px 13px;background:#087a43;color:white;font-weight:bold;cursor:pointer}
.secondary{background:#e5eee8;color:#17432d}
.danger{background:#b52d36}
nav{display:flex;gap:6px;padding:10px;background:white;overflow-x:auto}
nav button{white-space:nowrap;background:#e6eee8;color:#17432d}
nav button.active{background:#087a43;color:white}
main{max-width:1100px;margin:auto;padding:14px}
.section{display:none}.section.active{display:block}
h1{font-size:22px;margin:10px 0}
h3{margin-top:0}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin:15px 0}
.card,.panel{background:white;padding:15px;border-radius:12px;margin-bottom:12px;box-shadow:0 2px 9px #0000000a}
.metric{font-size:25px;font-weight:bold;color:#087a43;margin-top:8px}
.muted{color:#718078;font-size:13px}
form{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin:12px 0}
label{font-size:13px;font-weight:bold}
input,select,textarea{width:100%;padding:11px;border:1px solid #ccd8d0;border-radius:8px;font:inherit;margin-top:5px;background:white}
textarea{min-height:75px}
.tablewrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:13px}
td,th{text-align:right;padding:9px;border-bottom:1px solid #e6ece8;white-space:nowrap}
.notice{background:#eaf5ee;border-right:4px solid #087a43;padding:12px;border-radius:8px;font-size:13px;margin:12px 0}
.actions{display:flex;gap:7px;flex-wrap:wrap}
footer{text-align:center;padding:20px;color:#778078;font-size:12px}
a{color:#087a43}
@media(max-width:500px){main{padding:10px}.brand h2{font-size:14px}}
</style>
</head>
<body>

<header>
 <div class="brand">
  <img id="logo" alt="Al Majid">
  <div>
   <h2 id="brandTitle">مركز تحكم الماجد للذكاء الاصطناعي</h2>
   <small>AL MAJID AI CONTROL CENTER</small>
  </div>
 </div>
 <div class="actions">
  <button class="secondary" id="languageBtn">English</button>
  <label class="btn">رفع الشعار
   <input id="logoFile" type="file" accept="image/*" hidden>
  </label>
 </div>
</header>

<nav id="nav">
 <button class="active" data-page="home">الرئيسية</button>
 <button data-page="employees">الموظفون</button>
 <button data-page="clients">العملاء</button>
 <button data-page="orders">الطلبات</button>
 <button data-page="finance">المالية</button>
 <button data-page="reports">التقارير</button>
 <button data-page="history">سجل العمليات</button>
</nav>

<main>

<section id="home" class="section active">
 <h1>لوحة الإدارة الرئيسية</h1>
 <p class="muted">مرحباً بك في وكالة الماجد للتسويق.</p>
 <div class="cards">
  <div class="card">الموظفون<div class="metric" id="mEmployees">0</div></div>
  <div class="card">العملاء<div class="metric" id="mClients">0</div></div>
  <div class="card">الطلبات<div class="metric" id="mOrders">0</div></div>
  <div class="card">الإيرادات<div class="metric" id="mIncome">0</div><small>NGN</small></div>
  <div class="card">المصروفات<div class="metric" id="mExpense">0</div><small>NGN</small></div>
  <div class="card">الرصيد<div class="metric" id="mBalance">0</div><small>NGN</small></div>
 </div>
 <div class="notice">نسخة أولية: تحفظ البيانات على هذا المتصفح والجهاز. الربط بقاعدة البيانات السحابية سيتم في مرحلة لاحقة.</div>
</section>

<section id="employees" class="section">
 <h1>إدارة الموظفين</h1>
 <div class="panel">
  <h3>إضافة موظف أو موظفة</h3>
  <form id="employeeForm">
   <label>الاسم<input name="name" required></label>
   <label>الوظيفة<input name="job" required></label>
   <label>النوع<select name="type"><option>موظف ذكاء اصطناعي</option><option>موظف بشري</option></select></label>
   <label>الصلاحية<select name="permission">
    <option>إدارة التسويق</option><option>إدارة العملاء</option>
    <option>إدارة الطلبات</option><option>الإيرادات</option>
    <option>المصروفات</option><option>التقارير</option><option>مدير النظام</option>
   </select></label>
   <button>إضافة الموظف</button>
  </form>
 </div>
 <div class="panel"><h3>قائمة الموظفين</h3><div id="employeeList"></div></div>
</section>

<section id="clients" class="section">
 <h1>إدارة العملاء</h1>
 <div class="panel">
  <h3>إضافة عميل</h3>
  <form id="clientForm">
   <label>اسم العميل<input name="name" required></label>
   <label>رقم الهاتف<input name="phone"></label>
   <label>النشاط التجاري<input name="business"></label>
   <label>المدينة<input name="city" placeholder="Kano"></label>
   <button>حفظ العميل</button>
  </form>
 </div>
 <div class="panel"><h3>قائمة العملاء</h3><div id="clientList"></div></div>
</section>

<section id="orders" class="section">
 <h1>إدارة الطلبات</h1>
 <div class="panel">
  <h3>إضافة طلب جديد</h3>
  <form id="orderForm">
   <label>اسم العميل<input name="client" required></label>
   <label>الخدمة المطلوبة<input name="service" required></label>
   <label>قيمة الطلب بالنايرا<input name="amount" type="number" min="0"></label>
   <label>حالة الطلب<select name="status">
    <option>جديد</option><option>قيد التنفيذ</option><option>مكتمل</option><option>ملغي</option>
   </select></label>
   <button>حفظ الطلب</button>
  </form>
 </div>
 <div class="panel"><h3>قائمة الطلبات</h3><div id="orderList"></div></div>
</section>

<section id="finance" class="section">
 <h1>الإيرادات والمصروفات</h1>
 <div class="notice">سجّل الإيرادات والمصروفات وأرفق إيصال التحويل إن وجد.</div>
 <div class="panel">
  <h3>تسجيل عملية مالية</h3>
  <form id="financeForm">
   <label>نوع العملية<select name="type"><option value="income">إيراد</option><option value="expense">مصروف</option></select></label>
   <label>المبلغ بالنايرا<input name="amount" type="number" min="1" required></label>
   <label>البيان<input name="description" required></label>
   <label>إيصال التحويل<input name="receipt" type="file" accept="image/*,.pdf"></label>
   <button>حفظ العملية</button>
  </form>
 </div>
 <div class="panel"><h3>السجل المالي</h3><div id="financeList"></div></div>
</section>

<section id="reports" class="section">
 <h1>التقارير</h1>
 <div class="panel" id="reportContent"></div>
 <button id="exportBtn">تنزيل نسخة احتياطية</button>
</section>

<section id="history" class="section">
 <h1>سجل العمليات</h1>
 <div class="panel"><div id="historyList"></div></div>
</section>

</main>
<footer>AL MAJID AI CONTROL CENTER · NIGERIA · 2026</footer>

<script>
const $=id=>document.getElementById(id);
const keys=["employees","clients","orders","finance","history"];
let db={};

function load(){
 keys.forEach(k=>{
  try{db[k]=JSON.parse(localStorage.getItem("alm_"+k)||"[]")}
  catch(e){db[k]=[]}
 });
}
function persist(){
 try{
  keys.forEach(k=>localStorage.setItem("alm_"+k,JSON.stringify(db[k])));
  render();
 }catch(e){
  alert("مساحة التخزين ممتلئة. استخدم ملفاً أصغر للإيصال.");
 }
}
function safe(v){
 return String(v??"").replace(/[&<>"']/g,c=>({
 "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
 }[c]));
}
function log(action){
 db.history.unshift({action,time:new Date().toLocaleString()});
}
function add(key,obj){
 obj.id=Date.now().toString()+Math.random().toString(16).slice(2);
 db[key].unshift(obj);
 log("إضافة سجل: "+key);
 persist();
}
function removeItem(key,id){
 if(!confirm("هل تريد حذف هذا السجل؟"))return;
 db[key]=db[key].filter(x=>x.id!==id);
 log("حذف سجل: "+key);
 persist();
}
function makeTable(key,columns){
 if(!db[key].length)return '<p class="muted">لا توجد بيانات حتى الآن.</p>';
 let html='<div class="tablewrap"><table><thead><tr>';
 columns.forEach(c=>html+='<th>'+c[0]+'</th>');
 html+='<th>إجراء</th></tr></thead><tbody>';
 db[key].forEach(item=>{
  html+='<tr>';
  columns.forEach(c=>html+='<td>'+safe(item[c[1]])+'</td>');
  html+='<td><button class="danger" data-delete="'+key+'" data-id="'+safe(item.id)+'">حذف</button></td></tr>';
 });
 return html+'</tbody></table></div>';
}
function render(){
 $("employeeList").innerHTML=makeTable("employees",[
  ["الاسم","name"],["الوظيفة","job"],["النوع","type"],["الصلاحية","permission"]
 ]);
 $("clientList").innerHTML=makeTable("clients",[
  ["الاسم","name"],["الهاتف","phone"],["النشاط","business"],["المدينة","city"]
 ]);
 $("orderList").innerHTML=makeTable("orders",[
  ["العميل","client"],["الخدمة","service"],["المبلغ","amount"],["الحالة","status"]
 ]);
 $("financeList").innerHTML=makeTable("finance",[
  ["النوع","typeLabel"],["المبلغ","amount"],["البيان","description"],["التاريخ","date"]
 ]);
 $("historyList").innerHTML=makeTable("history",[
  ["العملية","action"],["التاريخ","time"]
 ]);
 const income=db.finance.filter(x=>x.type==="income").reduce((s,x)=>s+Number(x.amount),0);
 const expense=db.finance.filter(x=>x.type==="expense").reduce((s,x)=>s+Number(x.amount),0);
 $("mEmployees").textContent=db.employees.length;
 $("mClients").textContent=db.clients.length;
 $("mOrders").textContent=db.orders.length;
 $("mIncome").textContent=income.toLocaleString();
 $("mExpense").textContent=expense.toLocaleString();
 $("mBalance").textContent=(income-expense).toLocaleString();
 $("reportContent").innerHTML=
  "<p>عدد الموظفين: <b>"+db.employees.length+"</b></p>"+
  "<p>عدد العملاء: <b>"+db.clients.length+"</b></p>"+
  "<p>عدد الطلبات: <b>"+db.orders.length+"</b></p>"+
  "<p>إجمالي الإيرادات: <b>"+income.toLocaleString()+" NGN</b></p>"+
  "<p>إجمالي المصروفات: <b>"+expense.toLocaleString()+" NGN</b></p>"+
  "<p>صافي الرصيد: <b>"+(income-expense).toLocaleString()+" NGN</b></p>";
}
$("nav").addEventListener("click",e=>{
 const b=e.target.closest("[data-page]");
 if(!b)return;
 document.querySelectorAll("nav button").forEach(x=>x.classList.remove("active"));
 b.classList.add("active");
 document.querySelectorAll(".section").forEach(x=>x.classList.remove("active"));
 $(b.dataset.page).classList.add("active");
});
document.addEventListener("click",e=>{
 const b=e.target.closest("[data-delete]");
 if(b)removeItem(b.dataset.delete,b.dataset.id);
});
function data(form){return Object.fromEntries(new FormData(form).entries())}
$("employeeForm").addEventListener("submit",e=>{
 e.preventDefault();add("employees",data(e.target));e.target.reset();
});
$("clientForm").addEventListener("submit",e=>{
 e.preventDefault();add("clients",data(e.target));e.target.reset();
});
$("orderForm").addEventListener("submit",e=>{
 e.preventDefault();
 const d=data(e.target);d.amount=Number(d.amount||0);
 add("orders",d);e.target.reset();
});
$("financeForm").addEventListener("submit",async e=>{
 e.preventDefault();
 const d=data(e.target);
 const file=e.target.elements.receipt.files[0];
 if(file){
  if(file.size>500000){alert("حجم الإيصال يجب ألا يتجاوز 500 كيلوبايت في هذه النسخة.");return}
  d.receiptName=file.name;
  d.receipt=await new Promise((resolve,reject)=>{
   const reader=new FileReader();
   reader.onload=()=>resolve(reader.result);
   reader.onerror=reject;
   reader.readAsDataURL(file);
  });
 }
 d.amount=Number(d.amount);
 d.typeLabel=d.type==="income"?"إيراد":"مصروف";
 d.date=new Date().toLocaleString();
 add("finance",d);
 e.target.reset();
});
$("logoFile").addEventListener("change",e=>{
 const file=e.target.files[0];
 if(!file)return;
 if(file.size>500000){alert("اختر شعاراً حجمه أقل من 500 كيلوبايت.");return}
 const reader=new FileReader();
 reader.onload=()=>{
  try{
   localStorage.setItem("alm_logo",reader.result);
   $("logo").src=reader.result;
  }catch(err){alert("تعذر حفظ الشعار. اختر صورة أصغر.")}
 };
 reader.readAsDataURL(file);
});
$("exportBtn").addEventListener("click",()=>{
 const blob=new Blob([JSON.stringify(db,null,2)],{type:"application/json"});
 const url=URL.createObjectURL(blob);
 const a=document.createElement("a");
 a.href=url;a.download="al-majid-backup.json";a.click();
 URL.revokeObjectURL(url);
});
$("languageBtn").addEventListener("click",()=>{
 const english=document.documentElement.lang!=="en";
 document.documentElement.lang=english?"en":"ar";
 document.documentElement.dir=english?"ltr":"rtl";
 $("languageBtn").textContent=english?"العربية":"English";
 $("brandTitle").textContent=english?"AL MAJID AI CONTROL CENTER":"مركز تحكم الماجد للذكاء الاصطناعي";
});
load();
const savedLogo=localStorage.getItem("alm_logo");
if(savedLogo)$("logo").src=savedLogo;
render();
</script>
</body>
</html>